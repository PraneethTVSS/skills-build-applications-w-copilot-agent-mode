# Octofit Tracker Frontend Environment Configuration
# 
# Copy this file to .env.local and update with your values

# GitHub Codespaces Name
# Get this from your Codespaces URL: https://{CODESPACE_NAME}-8000.app.github.dev
# If running locally, you can leave this unset and the app will use http://localhost:8000
VITE_CODESPACE_NAME=your-codespace-name-here
